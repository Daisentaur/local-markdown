# Copy this file to ".env" and fill in your own values, then use ./run-public.sh
# These enable the admin login. Leave them unset for purely local use.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# A long random string that signs login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# API key so agents/scripts can call /api/ without a browser login.
# They send it as a header:  X-API-Key: <this>   (or  Authorization: Bearer <this>)
# Generate one with:
#   python3 -c "import secrets; print('mid_' + secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-api-key

# Optional overrides
HOST=127.0.0.1
PORT=5005

# --- OCR (scanned PDFs & images) ---
# Needs system tools: sudo apt install ocrmypdf tesseract-ocr
# Enabled by default when those are installed. Set to 0 to disable.
OCR_ENABLED=1
# Tesseract language(s), e.g. "eng", "eng+fra". Install extra langs with
# apt packages like tesseract-ocr-fra. Handwriting is NOT reliably supported.
OCR_LANGUAGE=eng
