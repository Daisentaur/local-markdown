[Unit]
# systemd service for MarkItDown Web — runs the app 24/7 via gunicorn.
# Install:  see DEPLOY.md. Edit the two placeholders below, then:
#   sudo cp deploy/markitdown.service /etc/systemd/system/markitdown.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now markitdown
Description=MarkItDown Web (file -> Markdown converter)
After=network-online.target
Wants=network-online.target

[Service]
# --- EDIT THESE TWO to match your server ---
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/local-markdown
# -------------------------------------------
EnvironmentFile=/home/YOUR_USER/local-markdown/.env
# 2 workers, 5-min timeout for big/slow conversions. Binds to localhost only;
# Cloudflare Tunnel is what reaches it from outside.
ExecStart=/home/YOUR_USER/local-markdown/.venv/bin/gunicorn \
  --workers 2 --bind 127.0.0.1:5005 --timeout 300 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
